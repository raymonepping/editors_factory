FROM node:22-alpine

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY src ./src
COPY identities ./identities

USER node

# No HTTP port — every agent is a background loop that calls out to
# factory-ollama and factory-api, never listens itself (design rule:
# no unbrokered agent-to-agent lateral communication). Liveness is
# checked via a heartbeat file the runtime touches every loop tick
# (agents/src/heartbeat.js) rather than an HTTP endpoint. Same caveat as
# backend/Containerfile: Podman's OCI build format ignores HEALTHCHECK
# entirely (found live building prompts/backend/01_01) — compose/agents/
# compose.yaml's own healthcheck stanza is what actually runs.
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=15s \
  CMD node -e "const fs=require('fs');const t=fs.statSync('/tmp/agent-heartbeat').mtimeMs;process.exit(Date.now()-t<60000?0:1)" || exit 1

CMD ["node", "src/index.js"]
