 }
+.factory-atmosphere::after {
+  content: '';
+  position: absolute;
+  inset: auto 0 0 0;
+  height: 34vh;
+  min-height: 220px;
+  background-image: var(--factory-skyline-svg);
+  background-repeat: repeat-x;
+  background-position: bottom;
+  background-size: 900px auto;
+  opacity: 0.55;
+}
 
